{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "JwtSettings": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryInMinutes": 30,
    "RefreshTokenExpiryInDays": 7
  },

  "Client": {
    "Url": ""
  },

  "GoogleAuth": {
    "ClientId": ""
  },

  "Email": {
    "Provider": "Smtp",
    "FromAddress": "",
    "FromName": "MovieMatch",
    "DefaultLanguage": "en",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseStartTls": true,
      "RequireAuth": true
    }
  },

  "Seeding": {
    "DataPath": "Data/ml-32m",
    "AdminEmail": "admin@moviematch.local",
    "AdminUsername": "admin",
    "AdminPassword": "Admin123!"
  },

  "OpenAI": {
    "ApiKey": ""
  },

  "TmdbSettings": {
    "AccessToken": "",
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/w500"
  },

  "BlobStorageSettings": {
    "ConnectionString": "",
    "ContainerName": "moviematch",
    "PublicBaseUrl": null
  },

  "RecommendationSettings": {
    "CfWeight": 0.65,
    "SemanticWeight": 0.35,
    "NegativeSignalWeight": 0.4,
    "ColdStartRatingThreshold": 10,
    "CandidatePoolSize": 200,
    "MmrLambda": 0.7,
    "BayesianMinVotes": 10,
    "BayesianGlobalMean": 3.5,
    "LikedThreshold": 4.0,
    "DislikedThreshold": 2.0
  },

  "Surveys": {
    "Version": 1,
    "Questions": [
      {
        "Id": "favorite_eras",
        "Type": "multi_select",
        "Required": true,
        "Question": {
          "uk": "Які кіноепохи вам подобаються?",
          "en": "Which film eras do you enjoy?"
        },
        "Options": [
          { "Id": "classic",  "Label": { "uk": "Класика (до 1970)", "en": "Classic (pre-1970)" } },
          { "Id": "70s_80s",  "Label": { "uk": "1970-1989",          "en": "1970-1989" } },
          { "Id": "90s_00s",  "Label": { "uk": "1990-2009",          "en": "1990-2009" } },
          { "Id": "modern",   "Label": { "uk": "Сучасні (2010+)",    "en": "Modern (2010+)" } }
        ]
      },
      {
        "Id": "mood_preferences",
        "Type": "scale_matrix",
        "Required": true,
        "Question": {
          "uk": "Наскільки вам подобаються наступні настрої?",
          "en": "How much do you enjoy these moods?"
        },
        "Rows": [
          "light_funny",
          "dark_serious",
          "thought_provoking",
          "action_intense",
          "romantic",
          "scary"
        ],
        "Scale": { "Min": 1, "Max": 5 }
      },
      {
        "Id": "violence_tolerance",
        "Type": "single_select",
        "Question": {
          "uk": "Який рівень насильства вам комфортний?",
          "en": "What level of on-screen violence are you comfortable with?"
        },
        "Options": [
          { "Id": "none",     "Label": { "uk": "Без насильства",        "en": "None" } },
          { "Id": "mild",     "Label": { "uk": "Незначне",              "en": "Mild" } },
          { "Id": "moderate", "Label": { "uk": "Середнє",               "en": "Moderate" } },
          { "Id": "heavy",    "Label": { "uk": "Високе (без обмежень)", "en": "Heavy (no limits)" } }
        ]
      },
      {
        "Id": "subtitle_dub_preference",
        "Type": "single_select",
        "Question": {
          "uk": "Як ви зазвичай дивитеся фільми іноземною мовою?",
          "en": "How do you prefer to watch foreign-language films?"
        },
        "Options": [
          { "Id": "original_with_subs", "Label": { "uk": "Оригінал з субтитрами", "en": "Original with subtitles" } },
          { "Id": "dubbed",             "Label": { "uk": "З дубляжем",            "en": "Dubbed" } },
          { "Id": "no_preference",      "Label": { "uk": "Без різниці",           "en": "No preference" } }
        ]
      },
      {
        "Id": "binge_vs_weekly",
        "Type": "single_select",
        "Question": {
          "uk": "Як ви дивитеся серіали?",
          "en": "How do you watch series?"
        },
        "Options": [
          { "Id": "binge",   "Label": { "uk": "Запоєм",       "en": "Binge-watch" } },
          { "Id": "weekly",  "Label": { "uk": "По одній серії", "en": "One episode at a time" } },
          { "Id": "depends", "Label": { "uk": "Залежить від серіалу", "en": "Depends on the show" } }
        ]
      },
      {
        "Id": "favorite_directors",
        "Type": "multi_text",
        "Max": 5,
        "Question": {
          "uk": "Назвіть до 5 улюблених режисерів",
          "en": "Name up to 5 favourite directors"
        }
      },
      {
        "Id": "rate_seed_movies",
        "Type": "rate_movies",
        "MoviePool": "popular_top_50",
        "MinRequired": 5,
        "Question": {
          "uk": "Оцініть фільми, які ви бачили (мінімум 5)",
          "en": "Rate the movies you have seen (minimum 5)"
        }
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
